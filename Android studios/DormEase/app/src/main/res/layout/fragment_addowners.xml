<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="admin.fragments.addowners">

    <!-- TODO: Update blank fragment layout -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/delete_owner_bg"
            android:scaleType="centerCrop"
            />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/main_uname"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="40dp"
                android:background="@drawable/curved_field2"
                android:drawableLeft="@drawable/user"
                android:hint="Name"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                app:hintAnimationEnabled="true" />
        </com.google.android.material.textfield.TextInputLayout>






        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:id="@+id/phone_layout"
            android:layout_below="@+id/main_uname"
            android:padding="5dp"
            android:layout_centerHorizontal="true"
            android:hint="phone"
            android:layout_marginTop="10dp"
            app:hintAnimationEnabled="true"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/curved_field2"
                android:id="@+id/phone"
                android:drawableLeft="@drawable/phone_icon"
                android:inputType="phone"
                android:textColor="#FFFFFF"


                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:id="@+id/mail_layout"
            android:layout_below="@+id/phone_layout"
            android:padding="5dp"
            android:layout_centerHorizontal="true"
            android:hint="Email"
            android:layout_marginTop="10dp"
            app:hintAnimationEnabled="true"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/curved_field2"
                android:id="@+id/email"
                android:drawableLeft="@drawable/e_mail"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"

                />
        </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="300dp"
                android:layout_marginTop="10dp"

                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_below="@+id/mail_layout"
                android:layout_centerHorizontal="true"
                android:hint="@string/Password"

                android:id="@+id/layout_password"
                tools:ignore="ExtraText">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:id="@+id/password"
                    android:drawableLeft="@drawable/password"
                    android:inputType="textPassword"
                    android:background="@drawable/curved_field2"
                    app:hintAnimationEnabled="true"/>

                />
            </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="300dp"
            android:layout_marginTop="10dp"

            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_below="@+id/layout_password"
            android:layout_centerHorizontal="true"
            android:hint="Confirm Password!!"

            android:id="@+id/layout_confirm_password"
            tools:ignore="ExtraText">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:id="@+id/confirmpassword"
                android:drawableLeft="@drawable/password"
                android:inputType="textPassword"
                android:background="@drawable/curved_field2"
                app:hintAnimationEnabled="true"/>

            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Licensing Documents(From nearby police station)"
            android:layout_below="@+id/layout_confirm_password"
            android:layout_marginTop="20dp"
            android:layout_centerHorizontal="true"
            android:id="@+id/textview_upload"
            android:textColor="@color/red"
            />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:layout_below="@+id/textview_upload"
            android:textColor="@color/black"
            android:layout_centerHorizontal="true"
            android:text="Select File"
            android:id="@+id/select_file"
            />
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_below="@+id/select_file"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:id="@+id/pdf"
            android:src="@drawable/baseline_file_present_24"
            android:visibility="gone"
            />


        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/add_owner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pdf"
            android:backgroundTint="@color/white"
            android:text="Add"
            android:layout_marginTop="30dp"
            android:layout_centerHorizontal="true"
            android:textAlignment="center" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:id="@+id/pb"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone"
            />


    </RelativeLayout>

</FrameLayout>