<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Maps.login_and_registration.owner_login">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/blue_light_blue"
        android:scaleType="centerCrop"/>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:id="@+id/main_uname"
        android:layout_below="@+id/med_imag"
        android:layout_marginTop="80dp"

        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/username"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:drawableLeft="@drawable/user"
            android:hint="Name"

            android:maxLines="1"
            android:background="@drawable/curved_fields"
            app:hintAnimationEnabled="true" />

    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="300dp"
        android:layout_marginTop="10dp"

        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_below="@+id/main_uname"
        android:layout_centerHorizontal="true"
        android:hint="@string/Password"

        android:id="@+id/layout_password"
        tools:ignore="ExtraText">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="#06f5ff"
            android:maxLines="1"
            android:id="@+id/password"
            android:drawableLeft="@drawable/password"
            android:inputType="textPassword"
            android:background="@drawable/curved_fields"
            app:hintAnimationEnabled="true"/>

        />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.constraintlayout.utils.widget.MotionButton
        android:id="@+id/outlinedLogin"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="Login"
        android:background="@drawable/curved_field"
        android:textColor="@color/black"
        android:textSize="15sp"
        android:layout_below="@+id/layout_password"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"

        />

    <ImageView
        android:layout_width="400dp"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:id="@+id/med_imag"
        android:src="@drawable/sahyadri_logo_logins"

        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="Owner"
        android:textStyle="bold"
        android:textSize="20dp"/>

</RelativeLayout>