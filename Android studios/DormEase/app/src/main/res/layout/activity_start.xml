<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".starting_activity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/blue_light_blue"
        android:scaleType="centerCrop"
        />

    <ImageView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="90dp"
        android:padding="5dp"
        android:src="@drawable/sahyadri_logo_logins"
        android:id="@+id/house_icon"
        />

    <androidx.constraintlayout.utils.widget.MotionButton
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="admin"
        android:id="@+id/admin"
        android:layout_below="@+id/house_icon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="90dp"
        android:background="@drawable/curved_field"
        android:textColor="@color/black"
        />

    <androidx.constraintlayout.utils.widget.MotionButton
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Owner"
        android:id="@+id/owner"
        android:layout_below="@+id/admin"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:background="@drawable/curved_field"
        android:textColor="@color/black"
        />

    <androidx.constraintlayout.utils.widget.MotionButton
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:id="@+id/user"
        android:text="User"
        android:textColor="@color/black"
        android:layout_below="@+id/owner"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:background="@drawable/curved_field"
        />

</RelativeLayout>