<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="10dp"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp"
    app:cardCornerRadius="30dp"
    android:id="@+id/notes_container"
    app:cardElevation="50dp"
    android:outlineSpotShadowColor="@color/blue"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/img_5"
            >


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30dp"
                android:text="pg name"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/pg_name"/>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/profile"
                android:src="@drawable/img_4"
                android:scaleType="centerCrop"
                android:padding="10dp"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="owner name"
                android:textSize="20sp"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:id="@+id/owner_name"
                />



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="cost per month "
                android:textSize="20sp"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:id="@+id/pg_cost"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="20sp"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:id="@+id/pg_location"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rooms Available"
                android:textSize="20sp"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:id="@+id/available_rooms"
                />

            <androidx.constraintlayout.utils.widget.MotionButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="\tMore Details \t"
                android:id="@+id/more_details"
                android:layout_margin="20dp"
                android:textColor="@color/black"
                android:background="@drawable/rounded_button_one"
                />



        </LinearLayout>

</androidx.cardview.widget.CardView>